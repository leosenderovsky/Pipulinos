# VITE_SITE_URL: URL pública/canónica del sitio. Si está vacía, se usa URL en production;
# en otros contextos DEPLOY_PRIME_URL; al final se prueba URL y luego DEPLOY_PRIME_URL.
VITE_SITE_URL=

# VITE_DEMO_BRAND_NAME: Nombre de marca para el banner DEMO (vacío hasta definir la marca).
VITE_DEMO_BRAND_NAME=
# VITE_DEMO_BRAND_URL: URL HTTP(S) del servicio a enlazar en el banner DEMO (vacía hasta definirla).
VITE_DEMO_BRAND_URL=

# APP_URL: URL pública usada en los retornos de Mercado Pago. En Netlify se usa URL si falta.
APP_URL=

# MERCADO_PAGO_ACCESS_TOKEN: Access Token de Mercado Pago (Checkout Pro).
# Configurar en el entorno del servidor, nunca en una variable VITE_.
# En producción, la API responde 503 si falta esta variable, salvo con MP_DEMO_MODE=true.
MERCADO_PAGO_ACCESS_TOKEN=

# MP_DEMO_MODE: permite generar una preferencia simulada sin token, incluso en producción.
# Solo usar explícitamente para pruebas; no se realiza ningún cobro.
MP_DEMO_MODE=false

# BRAND_ICON_BACKGROUND: fondo sólido opcional para favicon y apple touch icon.
BRAND_ICON_BACKGROUND=
