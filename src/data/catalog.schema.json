              "x-exampleData": true
            }
          },
          "stockBySize": {
            "type": "object",
            "title": "Stock por talle",
            "description": "Indicá la cantidad disponible para cada talle.",
            "x-group": "Secciones",
            "x-widget": "list",
            "additionalProperties": {
              "type": "number",
              "title": "Cantidad disponible",
              "description": "Ingresá la cantidad de unidades disponibles.",
              "x-group": "Secciones",
              "x-widget": "number"
            }
          },
          "featured": {
            "title": "Destacar el producto",
            "description": "Activá esta opción cuando corresponda.",
            "x-group": "Secciones",
            "x-widget": "boolean",
            "type": "boolean",
            "x-optional": true
          },
          "tags": {
            "type": "array",
