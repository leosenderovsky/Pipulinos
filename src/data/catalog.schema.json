            "x-group": "Secciones",
            "x-widget": "list",
            "items": {
              "title": "Etiqueta de búsqueda",
              "description": "Elegí una opción para «etiqueta de búsqueda».",
              "x-group": "Secciones",
              "x-widget": "select",
              "type": "string",
              "enum": [
                "body",
                "algodon-pima",
                "basico",
                "abrigo",
                "termico",
                "suave",
                "invierno",
                "pijama",
                "remera",
                "pack",
                "conjunto",
                "jogging",
                "friza",
                "antideslizante",
                "noche",
                "jardinero",
                "denim",
                "calza",
                "escarpines",
                "accesorio",
                "gorro",
                "babero",
                "recien-nacido",
                "buzo",
                "campera",
                "polar",
                "medias",
                "rustico",
                "comodo",
                "vestido",
                "verano",
                "muselina",
                "pantalon"
              ],
              "examples": [
                "body"
              ],
              "x-exampleData": true
            }
          },
          "isBundle": {
            "title": "Es un conjunto",
            "description": "Activá esta opción cuando corresponda.",
            "x-group": "Secciones",
            "x-widget": "boolean",
            "type": "boolean",
            "x-optional": true
          },
          "ageStagesOverride": {
            "type": "array",
            "title": "Etapas de edad del producto",
            "description": "Agregá, quitá o reordená los elementos de «etapas de edad del producto».",
            "x-group": "Secciones",
            "x-widget": "list",
            "items": {
              "title": "Etapa de edad",
              "description": "Elegí una opción para «etapa de edad».",
              "x-group": "Secciones",
              "x-widget": "select",
              "type": "string",
              "enum": [
                "recien-nacidos",
                "bebes",
                "ninos"
              ],
              "examples": [
                "recien-nacidos"
              ],
              "x-exampleData": true
            },
            "x-optional": true
          }
        },
        "required": [
          "id",
          "name",
          "category",
          "subcategory",
          "price",
          "sizes",
          "colors",
          "images",
          "description",
          "shortDescription",
          "material",
          "features",
          "careInstructions",
          "stockBySize",
          "tags"
        ],
        "additionalProperties": false
