{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "CatalogConfig",
  "description": "Configuración editable para el catálogo.",
  "x-group": "Secciones",
  "properties": {
    "$schema": {
      "title": "Archivo del esquema",
      "description": "Ruta al esquema que define esta configuración.",
      "x-group": "Secciones",
      "x-widget": "text",
      "type": "string"
    },
    "schemaVersion": {
      "title": "Versión del esquema",
      "description": "Versión del formato de configuración.",
      "x-group": "Secciones",
      "x-widget": "number",
      "type": "number"
    },
    "categories": {
      "type": "array",
      "title": "Categorías",
      "description": "Agregá, quitá o reordená los elementos de «categorías».",
      "x-group": "Secciones",
      "x-widget": "list",
      "items": {
        "type": "object",
        "title": "Categoría",
        "description": "Configurá los datos de «categoría».",
        "x-group": "Secciones",
        "properties": {
          "id": {
            "title": "Identificador",
            "description": "Ingresá el texto de «identificador».",
            "x-group": "Secciones",
            "x-widget": "text",
            "type": "string",
            "examples": [
              "Bodys & Enteritos"
            ],
            "x-exampleData": true
          },
          "label": {
            "title": "Nombre para mostrar",
            "description": "Ingresá el texto de «nombre para mostrar».",
            "x-group": "Secciones",
            "x-widget": "text",
            "type": "string",
            "examples": [
              "Bodys & Enteritos"
            ],
            "x-exampleData": true
          },
          "emoji": {
            "title": "Ícono de la categoría",
            "description": "Elegí una opción para «ícono de la categoría».",
            "x-group": "Secciones",
            "x-widget": "icon",
            "type": "string",
            "examples": [
              "🧸"
            ],
            "x-exampleData": true
          }
        },
        "required": [
          "id",
          "label",
          "emoji"
        ],
        "additionalProperties": false
      }
    },
    "products": {
      "type": "array",
      "title": "Productos",
      "description": "Agregá, quitá o reordená los elementos de «productos».",
      "x-group": "Secciones",
      "x-widget": "list",
      "items": {
        "type": "object",
        "title": "Producto",
        "description": "Configurá los datos de «producto».",
        "x-group": "Secciones",
        "properties": {
          "id": {
            "title": "Identificador",
            "description": "Ingresá el texto de «identificador».",
            "x-group": "Secciones",
            "x-widget": "text",
            "type": "string",
            "examples": [
              "body-manga-larga-algodon-pima"
            ],
            "x-exampleData": true
          },
          "name": {
            "title": "Nombre del producto",
            "description": "Ingresá el texto de «nombre del producto».",
            "x-group": "Secciones",
            "x-widget": "text",
            "type": "string",
            "examples": [
              "Body Manga Larga Algodón Pima Estampado Estrellitas"
            ],
            "x-exampleData": true
          },
          "category": {
            "title": "Categoría",
            "description": "Ingresá el texto de «categoría».",
            "x-group": "Secciones",
            "x-widget": "text",
            "type": "string",
            "examples": [
              "Bodys & Enteritos"
            ],
            "x-exampleData": true
          },
          "subcategory": {
            "title": "Subcategoría",
            "description": "Ingresá el texto de «subcategoría».",
            "x-group": "Secciones",
            "x-widget": "text",
            "type": "string",
            "examples": [
              "Bodys"
            ],
            "x-exampleData": true
          },
          "price": {
            "title": "Precio",
            "description": "Ingresá el valor de «precio».",
            "x-group": "Secciones",
            "x-widget": "number",
            "type": "number"
          },
          "compareAtPrice": {
            "title": "Precio anterior",
            "description": "Ingresá el valor de «precio anterior».",
            "x-group": "Secciones",
            "x-widget": "number",
            "type": "number",
            "x-optional": true
          },
          "sizes": {
            "type": "array",
            "title": "Talles disponibles",
            "description": "Agregá, quitá o reordená los elementos de «talles disponibles».",
            "x-group": "Secciones",
            "x-widget": "list",
            "items": {
              "title": "Talle disponible",
              "description": "Ingresá el texto de «talle disponible».",
              "x-group": "Secciones",
              "x-widget": "text",
              "type": "string",
              "examples": [
                "RN"
              ],
              "x-exampleData": true
            }
          },
          "colors": {
            "type": "array",
            "title": "Colores disponibles",
            "description": "Agregá, quitá o reordená los elementos de «colores disponibles».",
            "x-group": "Secciones",
            "x-widget": "list",
            "items": {
              "type": "object",
              "title": "Color disponible",
              "description": "Configurá los datos de «color disponible».",
              "x-group": "Secciones",
              "properties": {
                "name": {
                  "title": "Nombre del producto",
                  "description": "Ingresá el texto de «nombre del producto».",
                  "x-group": "Secciones",
                  "x-widget": "text",
                  "type": "string",
                  "examples": [
                    "Amarillo Sol"
                  ],
                  "x-exampleData": true
                },
                "hex": {
                  "title": "Código del color",
                  "description": "Elegí el color para «código del color».",
                  "x-group": "Secciones",
                  "x-widget": "color",
                  "type": "string",
                  "examples": [
                    "#FFD026"
                  ],
                  "x-exampleData": true
                },
                "colorFamily": {
                  "title": "Familia del color",
                  "description": "Elegí una opción para «familia del color».",
                  "x-group": "Secciones",
                  "x-widget": "select",
                  "type": "string",
                  "examples": [
                    "amarillo"
                  ],
                  "x-exampleData": true,
                  "enum": [
                    "amarillo",
                    "coral",
                    "celeste",
                    "verde",
                    "lila",
                    "naranja",
                    "neutro"
                  ],
                  "x-optional": true
                }
              },
              "required": [
                "name",
                "hex"
              ],
              "additionalProperties": false
            }
          },
          "images": {
            "type": "array",
            "title": "Imágenes del producto",
            "description": "Agregá, quitá o reordená los elementos de «imágenes del producto».",
            "x-group": "Imágenes",
            "x-widget": "list",
            "items": {
              "title": "Foto del producto",
              "description": "Elegí una foto del producto. La variante WebP con el mismo nombre se genera mediante images:optimize.",
              "x-group": "Imágenes",
              "x-widget": "image",
              "type": "string",
              "examples": [
                "/assets/products/body-manga-larga-algodon-pima.jpg"
              ],
              "x-exampleData": true,
              "x-asset": {
                "path": "/assets/products/{id}.jpg",
                "minWidth": 900,
                "ratio": [
                  0.8,
                  1
                ]
              }
            }
          },
          "description": {
            "title": "Descripción",
            "description": "Ingresá el texto de «descripción».",
            "x-group": "Secciones",
            "x-widget": "textarea",
            "type": "string",
            "examples": [
              "Confeccionado artesanalmente en 100% Algodón Pima puro peinado, este body brinda la caricia más suave para la piel sensible de tu bebé. Su cuello americano extensible permite deslizarlo hacia abajo sin apretar las orejitas en caso de cambios de emergencia, mientras sus broches metálicos reforzados libres de níquel garantizan máxima seguridad y durabilidad lavado tras lavado."
            ],
            "x-exampleData": true
          },
          "shortDescription": {
            "title": "Descripción breve del producto",
            "description": "Ingresá el texto de «descripción breve del producto».",
            "x-group": "Secciones",
            "x-widget": "textarea",
            "type": "string",
            "examples": [
              "100% Pima peinado con broches hipoalergénicos y cuello americano extensible."
            ],
            "x-exampleData": true
          },
          "material": {
            "title": "Material",
            "description": "Ingresá el texto de «material».",
            "x-group": "Secciones",
            "x-widget": "text",
            "type": "string",
            "examples": [
              "100% Algodón Pima"
            ],
            "x-exampleData": true
          },
          "badge": {
            "title": "Etiqueta destacada",
            "description": "Ingresá el texto de «etiqueta destacada».",
            "x-group": "Secciones",
            "x-widget": "text",
            "type": "string",
            "examples": [
              "¡Más pedido!"
            ],
            "x-exampleData": true,
            "x-optional": true
          },
          "badgeType": {
            "title": "Tipo de etiqueta",
            "description": "Elegí una opción para «tipo de etiqueta».",
            "x-group": "Secciones",
            "x-widget": "select",
            "type": "string",
            "examples": [
              "pima"
            ],
            "x-exampleData": true,
            "enum": [
              "destacado",
              "oferta",
              "nuevo",
              "termico",
              "pima"
            ],
            "x-optional": true
          },
          "features": {
            "type": "array",
            "title": "Características",
