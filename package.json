    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "autoprefixer": "^10.4.21",
    "json-schema-to-typescript": "^16.0.0",
    "sharp": "^0.35.5",
