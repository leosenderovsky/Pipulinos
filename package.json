    "check:images:strict": "node scripts/check-images.mjs --strict",
    "images:optimize": "node scripts/optimize-images.mjs",
    "generate:types": "node scripts/generate-types.mjs",
    "check:config": "node scripts/check-config.mjs",
    "check:config:strict": "node scripts/check-config.mjs --strict",
