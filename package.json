  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "predev": "npm run generate:types",
    "prebuild": "npm run generate:types",
    "build": "vite build",
    "verify:deploy": "node scripts/verify-deploy.mjs",
    "start": "tsx server.ts",
    "preview": "vite preview",
    "icons:make": "node scripts/make-icons.mjs",
    "check:icons": "node scripts/check-icons.mjs",
    "logo:optimize": "node scripts/optimize-logo.mjs",
    "make:og": "node scripts/make-og-image.mjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "check:filters": "tsx scripts/check-filters.ts",
